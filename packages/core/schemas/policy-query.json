{
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req-"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name",
        "session_id"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "args_meta": {
          "type": "object",
          "properties": {
            "cmd_hash": {
              "type": "string",
              "minLength": 1
            },
            "cmd_class": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "tool",
        "args_meta"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file",
            "process",
            "network",
            "memory",
            "credential"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "request_id",
    "policy_version",
    "subject",
    "action",
    "resource"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
